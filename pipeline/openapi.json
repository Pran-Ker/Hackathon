{
  "openapi": "3.1.0",
  "info": {
    "title": "Mesh \u2014 Image \u2192 3D Pipeline API",
    "description": "Turn a single product photo into a web-ready 3D model.\n\n**Pipeline:** isolate subject (BiRefNet) \u2192 describe (Claude) \u2192 synthesize orbit views \u2192 image-to-3D (Hunyuan3D) \u2192 optimize GLB + emit a typed r3f component and a native Three.js component.\n\n**Idempotent:** each upload is keyed by the SHA-256 of its bytes; re-uploading the same image returns the existing result instantly (`cached: true`).\n\n**Durable:** results persist under `outputs/imagine/<sha16>/` and survive restarts.\n\n**LAN-friendly:** every returned URL is rooted at the request host, so a model generated by a remote device loads on that device. Produced files are served under `/files/...`. First-time generation takes ~3\u20134 minutes (Hunyuan3D).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness + LAN URLs",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "get": {
        "tags": [
          "generations"
        ],
        "summary": "List all generations on disk",
        "description": "Durable manifest of every generation currently on disk (newest first).",
        "operationId": "runs_api_runs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunEntry"
                  },
                  "type": "array",
                  "title": "Response Runs Api Runs Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/edit": {
      "post": {
        "tags": [
          "edit (legacy)"
        ],
        "summary": "Click-to-edit \u2192 fal image",
        "operationId": "edit_api_edit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/imagine": {
      "post": {
        "tags": [
          "generations"
        ],
        "summary": "Photo \u2192 3D model (single)",
        "description": "Photo -> 3D: isolate subject, image_to_3d, compile to an optimized GLB\n+ typed r3f component. Returns request-host-rooted URLs **and ready-to-use\nThree.js code** (`threejs_html`, `threejs_native`). Idempotent by image\ncontent, durable across restarts.\n\nFirst-time generation takes ~3-4 min; a repeat of the same image returns\ninstantly with `cached: true`. To send several images at once, use\n`/imagine/batch`.",
        "operationId": "imagine_imagine_post",
        "parameters": [
          {
            "name": "native",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include the self-contained native Three.js source in the response.",
              "default": true,
              "title": "Native"
            },
            "description": "Include the self-contained native Three.js source in the response."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_imagine_imagine_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImagineResponse"
                }
              }
            }
          },
          "400": {
            "description": "Upload is not an image or is empty.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Pipeline failure (fal/compile error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/imagine/batch": {
      "post": {
        "tags": [
          "generations"
        ],
        "summary": "Photos \u2192 3D models (parallel batch)",
        "description": "Send several images in one request; they run through the pipeline\n**concurrently** (wall-clock \u2248 the slowest single image, not the sum). Each\nresult is independent \u2014 one image failing does not fail the others.\n\nEvery image is content-addressed, so duplicates (within the batch or from a\nprevious call) return instantly as cache hits.",
        "operationId": "imagine_batch_imagine_batch_post",
        "parameters": [
          {
            "name": "native",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include the self-contained native Three.js source per result.",
              "default": true,
              "title": "Native"
            },
            "description": "Include the self-contained native Three.js source per result."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_imagine_batch_imagine_batch_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "No images, or too many (max 8).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchItem": {
        "properties": {
          "filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImagineResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "BatchItem"
      },
      "BatchResponse": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/BatchItem"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "count",
          "results"
        ],
        "title": "BatchResponse"
      },
      "Body_imagine_batch_imagine_batch_post": {
        "properties": {
          "images": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Images",
            "description": "2\u20138 photos in the 'images' field. Processed concurrently."
          }
        },
        "type": "object",
        "required": [
          "images"
        ],
        "title": "Body_imagine_batch_imagine_batch_post"
      },
      "Body_imagine_imagine_post": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "description": "Photo of a single subject (PNG/JPG/WEBP)."
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_imagine_imagine_post"
      },
      "EditRequest": {
        "properties": {
          "point": {
            "$ref": "#/components/schemas/Point"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          }
        },
        "type": "object",
        "required": [
          "point",
          "prompt"
        ],
        "title": "EditRequest"
      },
      "EditResponse": {
        "properties": {
          "image_url": {
            "type": "string",
            "title": "Image Url"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "image_url",
          "note"
        ],
        "title": "EditResponse"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "lan_ip": {
            "type": "string",
            "title": "Lan Ip",
            "description": "This machine's LAN IP, for building the share URL."
          },
          "base_url": {
            "type": "string",
            "title": "Base Url",
            "description": "Base URL derived from the incoming request."
          }
        },
        "type": "object",
        "required": [
          "ok",
          "lan_ip",
          "base_url"
        ],
        "title": "HealthResponse"
      },
      "ImagineResponse": {
        "properties": {
          "glb_url": {
            "type": "string",
            "title": "Glb Url",
            "description": "Meshopt-compressed, web-ready GLB."
          },
          "component_url": {
            "type": "string",
            "title": "Component Url",
            "description": "Typed react-three-fiber <Model/> (.tsx)."
          },
          "native_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Native Url",
            "description": "Self-contained native Three.js component (.js), if produced."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Detected subject name (may be null)."
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "size_before": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Before",
            "description": "Raw GLB size in bytes."
          },
          "size_after": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size After",
            "description": "Optimized GLB size in bytes."
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "description": "True if returned from an existing result (idempotent hit)."
          },
          "threejs_html": {
            "type": "string",
            "title": "Threejs Html",
            "description": "Drop-in standalone .html page that renders this model (loads the GLB)."
          },
          "threejs_native": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threejs Native",
            "description": "Self-contained native Three.js component source (createModel()); geometry inlined, no loader/asset needed. Null if transpile was skipped or `native=false`."
          }
        },
        "type": "object",
        "required": [
          "glb_url",
          "component_url",
          "cached",
          "threejs_html"
        ],
        "title": "ImagineResponse"
      },
      "Point": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "z": {
            "type": "number",
            "title": "Z"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Point"
      },
      "RunEntry": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Content hash (sha16) or legacy timestamp id."
          },
          "input": {
            "type": "string",
            "title": "Input"
          },
          "cutout": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cutout"
          },
          "glb": {
            "type": "string",
            "title": "Glb"
          },
          "raw": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw"
          },
          "native": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Native"
          },
          "optSize": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Optsize",
            "description": "Optimized GLB size in MB."
          },
          "rawSize": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rawsize",
            "description": "Raw GLB size in MB."
          }
        },
        "type": "object",
        "required": [
          "id",
          "input",
          "glb"
        ],
        "title": "RunEntry",
        "description": "One generation as recorded on disk (paths are relative to /files/imagine/)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "generations",
      "description": "Create 3D models from photos and list past runs."
    },
    {
      "name": "meta",
      "description": "Liveness and LAN discovery."
    },
    {
      "name": "edit (legacy)",
      "description": "Old splat click-to-edit path (image only; not wired to 3D)."
    }
  ]
}